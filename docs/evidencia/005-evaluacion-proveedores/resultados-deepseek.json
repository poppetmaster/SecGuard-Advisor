        "document_title": "Artificial Intelligence Risk Management Framework (AI RMF 1.0)",
        "source_id": "airmf",
        "check_status": "valid",
        "quote": "the Core is composed of four functions: GOVERN , MAP, MEASURE ,\nand MANAGE .",
        "resolvable": true,
