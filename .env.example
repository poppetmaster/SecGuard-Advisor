# Entorno de ejecucion: development | test | production
APP_ENV=development

# Inferencia local (Ollama nativo)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Generador configurable (005). Proveedor activo: ollama | deepseek | anthropic.
# Ollama es el valor predeterminado y el unico implementado en la Entrega 1.
# Precedencia para Ollama: SECGUARD_GENERATION_MODEL > OLLAMA_MODEL;
# SECGUARD_GENERATION_MAX_OUTPUT_TOKENS > generator_num_predict;
# SECGUARD_GENERATION_TIMEOUT_SECONDS > llm_timeout_seconds.
# Los proveedores externos exigen credencial y presupuesto aprobado; no hay fallback.
SECGUARD_GENERATION_PROVIDER=ollama
SECGUARD_GENERATION_MODEL=
SECGUARD_GENERATION_MAX_OUTPUT_TOKENS=
SECGUARD_GENERATION_TIMEOUT_SECONDS=
SECGUARD_GENERATION_REASONING=off

# Credenciales externas. VACIAS por defecto. Nunca versionar valores reales.
# En la Entrega 1 los proveedores externos responden "no implementado".
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2026-10-21

# Presupuesto externo en USD. 0 bloquea toda llamada externa.
SECGUARD_EXTERNAL_BUDGET_USD=0
SECGUARD_EXTERNAL_RUN_BUDGET_USD=0
SECGUARD_EXTERNAL_TARIFF_VERSION=2026-11-22
# Ventana y estimación conservadora para proveedores externos. La estimación
# no es un conteo exacto ni una garantía contra truncamiento.
SECGUARD_EXTERNAL_CONTEXT_WINDOW_TOKENS=128000
SECGUARD_EXTERNAL_ESTIMATE_CHARS_PER_TOKEN=2.0
SECGUARD_EXTERNAL_ESTIMATE_OVERHEAD_TOKENS=64

# Almacenamiento local: SQLite, originales del corpus y control de Qdrant
SECGUARD_STORAGE_DIR=./storage

# Qdrant local (corte 1). El ID es estable, opaco y distinto por almacenamiento.
# No se genera al arrancar ni contiene rutas privadas. Ejemplo: local-dev
SECGUARD_INSTANCE_ID=
SECGUARD_QDRANT_URL=http://127.0.0.1:6333
SECGUARD_QDRANT_TIMEOUT_SECONDS=5

# LangSmith: deje LANGSMITH_API_KEY vacia para desactivar el envio de trazas.
# Solo se envian datos sinteticos o publicos autorizados. Nunca registre secretos.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=secguard-advisor-dev

# Identidad local declarada para la revision humana. No es autenticacion.
# Sin valor, no se permite guardar una revision del respaldo semantico.
SECGUARD_REVIEWER_NAME=

# Espera maxima por el turno de generacion global antes de rechazar (segundos)
SECGUARD_GENERATION_QUEUE_TIMEOUT_SECONDS=5

# Límites del CSV filtrado de Qualys. La importación es local; no se envían filas a servicios externos.
SECGUARD_QUALYS_MAX_BYTES=10485760
SECGUARD_QUALYS_MAX_ROWS=10000
SECGUARD_QUALYS_MAX_FIELD_CHARS=20000
SECGUARD_QUALYS_MAX_CVES=1000
SECGUARD_QUALYS_STAGING_TTL_SECONDS=86400
