# Entorno de ejecucion: development | test | production
APP_ENV=development

# Inferencia local (Ollama nativo)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Almacenamiento local: SQLite, Chroma y originales del corpus
SECGUARD_STORAGE_DIR=./storage

# LangSmith: deje LANGSMITH_API_KEY vacia para desactivar el envio de trazas.
# Solo se envian datos sinteticos o publicos autorizados. Nunca registre secretos.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=secguard-advisor-dev

# Identidad local declarada para la revision humana. No es autenticacion.
# Sin valor, no se permite guardar una revision del respaldo semantico.
SECGUARD_REVIEWER_NAME=

# Espera maxima por el turno de generacion global antes de rechazar (segundos)
SECGUARD_GENERATION_QUEUE_TIMEOUT_SECONDS=5

# Límites del CSV filtrado de Qualys. La importación es local; no se envían filas a servicios externos.
SECGUARD_QUALYS_MAX_BYTES=10485760
SECGUARD_QUALYS_MAX_ROWS=10000
SECGUARD_QUALYS_MAX_FIELD_CHARS=20000
SECGUARD_QUALYS_MAX_CVES=1000
SECGUARD_QUALYS_STAGING_TTL_SECONDS=86400
